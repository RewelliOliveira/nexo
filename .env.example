# LLM provider key (OpenAI). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key
# Optional: any Mastra model id (provider/model). Default: openai/gpt-5.4-mini
AGENT_MODEL=

# libSQL: local file in development, Turso URL (libsql://...) in production
DATABASE_URL=file:nexo.db
DATABASE_AUTH_TOKEN=

# Mastra storage (agent memory). Defaults to a local mastra.db file
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Probability (0-1) that a call to the simulated legacy ticket service fails
TICKET_SERVICE_FAILURE_RATE=0.1

# Secret used to sign the session cookie (HMAC-SHA256), at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
